<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>BlueCue</string>
    <key>CFBundleIconFile</key>
    <string>icon</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>com.bluecue.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>BlueCue</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>BlueCue needs Bluetooth access to discover and stream audio to Bluetooth speakers.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>BlueCue needs Bluetooth access to discover and stream audio to Bluetooth speakers.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>BlueCue uses the microphone to measure output delay during acoustic calibration.</string>
</dict>
</plist>
